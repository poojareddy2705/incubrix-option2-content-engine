# IncuBrix Content Engine - Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# AI Provider (leave blank to use mock mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Engine Settings (overrides config/engine.yaml)
CONTENT_ENGINE_PROVIDER=mock
CONTENT_ENGINE_BASE_URL=https://example.com
CONTENT_ENGINE_CAMPAIGN=creator_os_launch
CONTENT_ENGINE_SEED=42
